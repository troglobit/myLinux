module mylinux {
    yang-version 1.1;
    namespace "urn:mylinux";
    prefix my;

    import ietf-datastores {
        prefix ds;
    }

    import ietf-factory-default {
        prefix fd;
    }

    import ietf-netconf-notifications {
        prefix ncn;
    }

    import ietf-system {
        prefix sys;
    }

    import mylinux-system {
        prefix mysys;
    }

    import ietf-interfaces {
        prefix if;
    }
    import ietf-ip {
        prefix ip;
    }
    import iana-if-type {
        prefix ianaift;
    }
    import mylinux-interfaces {
        prefix myif;
    }

    import clixon-autocli {
        prefix autocli;
    }

    description
        "Base model
         ";

    revision 2023-02-10 {
      description
	"Initial revision.";
      reference
	"N/A";
    }
    revision 2023-03-16 {
      description "Add timezone deviations for system/clock.";
      reference "N/A";
    }
    revision 2026-08-07 {
      description "Rebrand the base model as mylinux.";
      reference "N/A";
    }
    revision 2026-08-12 {
      description "Pull in ietf-factory-default for the factory-reset RPC.";
      reference "N/A";
    }
    revision 2026-11-14 {
      description "Pull in ietf-netconf-notifications for netconf-config-change.";
      reference "N/A";
    }

    revision 2026-11-15 {
      description "Pull in mylinux-interfaces.";
      reference "N/A";
    }

    revision 2026-11-16 {
      description
        "The deviation for the UTC offset names the choice and case on
         the way to it, as a schema node identifier has to.";
      reference "N/A";
    }

    deviation "/sys:system/sys:clock/sys:timezone/sys:timezone-utc-offset/sys:timezone-utc-offset" {
      deviate not-supported;
    }
}
