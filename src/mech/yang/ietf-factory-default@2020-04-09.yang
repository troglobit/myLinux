module ietf-factory-default {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:ietf-factory-default";
  prefix fd;

  import ietf-datastores {
    prefix ds;
    reference
      "RFC 8342: Network Management Datastore Architecture (NMDA)";
  }

  organization
    "IETF NETCONF (Network Configuration) Working Group";
  contact
    "WG Web:   <https://datatracker.ietf.org/wg/netconf/>
     WG List:  <mailto:netconf@ietf.org>";
  description
    "This module defines a factory-reset RPC to allow a client to reset
     a server back to its factory default condition, and a read-only
     factory-default datastore holding that condition.

     Copyright (c) 2020 IETF Trust and the persons identified as authors
     of the code.  All rights reserved.  Redistribution and use per the
     Simplified BSD License in the RFC 8808 Trust Legal Provisions.";

  revision 2020-04-09 {
    description
      "Initial revision.";
    reference
      "RFC 8808: A YANG Data Model for Factory Default Settings";
  }

  rpc factory-reset {
    description
      "The server resets all its datastores back to their factory
       default contents.  On myLinux this reapplies the factory config,
       dropping any running configuration.";
  }

  identity factory-default {
    base ds:datastore;
    description
      "The read-only datastore holding the factory default configuration.";
  }
}
