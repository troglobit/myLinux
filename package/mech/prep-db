#!/bin/sh
set -e

DBDIR=/run/clixon/db
FACTORY=$DBDIR/factory_db
STARTUP=/var/lib/misc/startup_db

# Own our directories and the startup symlink here rather than relying on
# tmpfiles having run first: clixon reads $DBDIR/startup_db, and if that
# link (or the dirs) is not in place before clixon loads -s startup we
# boot with an empty startup and no admin user, silently.  $DBDIR is on a
# ramdisk; the startup config itself persists on /var/lib.
mkdir -p "$DBDIR" /var/lib/misc
ln -sf "$STARTUP" "$DBDIR/startup_db"

# TODO: Maybe copy in a proper factory config from
# /usr/share/vendor/<hardware-id>_db or similar.
# Right now we generate one from probed data.
#
# The quoted heredoc keeps the shell from mangling the '$6$' password
# hash.  'admin' logs in with password 'admin' until a real factory-reset
# flow lets the operator set their own; mech creates the UNIX account
# (in group wheel) when this config is applied on first boot.
cat <<'EOF' >"$FACTORY"
<config>
  <system xmlns="urn:ietf:params:xml:ns:yang:ietf-system">
    <authentication>
      <user>
        <name>admin</name>
        <password>$6$mylinuxadmin$RVLCgKhKzYZtNSL/3d7suu99ECntGXGbtt.4N9o0mhyo03RUcP1NgLbf2MWzmhFNZ/1oxuoEk1w9VDp6G4a8D.</password>
      </user>
    </authentication>
  </system>
  <restconf xmlns="http://clicon.org/restconf">
    <enable>true</enable>
    <auth-type>none</auth-type>
    <fcgi-socket>/run/clixon/restconf.sock</fcgi-socket>
  </restconf>
</config>
EOF

# Seed the startup config from the factory on first boot or after a reset.
# Test -s, not -f: a stray empty startup_db (e.g. one clixon wrote before
# we seeded) must be reseeded too, else it sticks as an empty config.
if [ ! -s "$STARTUP" ]; then
	cp "$FACTORY" "$STARTUP"
	logger -sik -p user.notice -t prep-db "Seeded startup-config from factory"
fi
