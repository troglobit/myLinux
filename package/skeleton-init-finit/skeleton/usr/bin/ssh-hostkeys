#!/bin/sh
# Host keys live on persistent storage so the device keeps its SSH
# identity across reboots -- /etc is a ramdisk.  A factory-reset wipes
# /mnt (and this with it), so a fresh identity is generated next boot.
tmp=$(mktemp)
dir=/var/lib/ssh

log()
{
    prio=notice
    if [ "$1" = "-p" ]; then
	prio=$2
	shift 2
    fi
    logger -sik -p "security.$prio" -t sshd "$@"
}

check()
{
    if sshd -t >"$tmp" 2>&1; then
	log "SSH host keys OK"
	return 0
    fi
    return 1
}

mkdir -p "$dir" && chmod 0700 "$dir"

rc=0
if ! check; then
    files=$(awk '/invalid format/{print $6}' "$tmp" | sed 's/.*"\(.*\)".*/\1/')
    for file in $files; do
	log -p warn "Removing $file: invalid format!"
	rm "$file"
    done

    log "Generating SSH host keys ..."
    for type in rsa ecdsa ed25519; do
	key="$dir/ssh_host_${type}_key"
	[ -f "$key" ] || ssh-keygen -q -t "$type" -f "$key" -N ""
    done

    if ! check; then
	log -p err "Failed generating SSH host keys!"
	rc=1
    fi
fi

rm "$tmp"
exit $rc
