config BR2_PACKAGE_WEBIF
	bool "webif - web interface"
	depends on BR2_PACKAGE_MECH
	select BR2_PACKAGE_MERECAT
	help
	  The myLinux web interface: status, system and interface
	  settings, and maintenance.  A static page that talks RESTCONF
	  to clixon from the browser, so it has no server side of its
	  own.  Merecat serves it and fronts the RESTCONF API.

	  Log in as any local user with administrator rights.

comment "webif needs mech"
	depends on !BR2_PACKAGE_MECH
