+ * those that nothing left is held up on.  The ones taken down are moved
+ * to gone.
+ */
 static bool
-takedown_stored(const char *ifname, struct lif_dict *state)
+takedown_stale(struct lif_dict *stale, struct lif_dict *old, struct lif_dict *state,
+	       struct lif_dict *gone)
 {
-	struct lif_dict old = {};
-	struct lif_interface_file_parse_state ps = { .collection = &old };
-	struct lif_dict_entry *entry;
+	struct lif_node *iter, *next;
 	bool ret = true;
 
-	lif_interface_collection_init(&old);
+	while (stale->list.head != NULL)
+	{
+		bool progress = false;
 
-	if (!lif_interface_file_parse(&ps, snapshot_path(ifname)))
-		return true;
+		LIF_DICT_FOREACH_SAFE(iter, next, stale)
+		{
+			struct lif_dict_entry *entry = iter->data;
+			struct lif_interface *iface = entry->data;
+
+			/* A loop of more than two cannot be, but if so: just go */
+			if (held_up(stale, iface) && (progress || next != NULL))
+				continue;
 
-	lif_lifecycle_count_rdepends(&exec_opts, &old);
-	lif_compat_apply(&old);
-	lif_state_sync(state, &old);
+			if (exec_opts.verbose)
+				fprintf(stderr, "%s: bringing interface %s down\n", argv0, iface->ifname);
 
-	entry = lif_dict_find(&old, ifname);
-	if (entry != NULL)
-		ret = change_interface(entry->data, &old, state, false);
+			if (!lif_lifecycle_run(&exec_opts, iface, old, state, iface->ifname, false))
+			{
+				fprintf(stderr, "%s: failed to bring interface %s down\n", argv0, iface->ifname);
+				ret = false;
+			}
+
+			/* Down it is, whoever else the state file says uses it */
+			lif_state_delete(state, iface->ifname);
+			lif_dict_add(gone, entry->key, NULL);
+			lif_dict_delete_entry(stale, entry);
+			progress = true;
+		}
+	}
 
 	return ret;
 }
@@ -270,11 +436,10 @@ ifreload_main(int argc, char *argv[])
 	(void) argc;
 	(void) argv;
 
-	struct lif_dict cur = {}, state = {};
+	struct lif_dict cur = {}, old = {}, state = {}, stale = {}, gone = {};
 	struct lif_interface_file_parse_state parse = { .collection = &cur };
 	struct lif_node *iter;
 	int rc = EXIT_SUCCESS;
-	DIR *d;
 
 	lif_interface_collection_init(&cur);
 
@@ -308,31 +473,15 @@ ifreload_main(int argc, char *argv[])
 		return EXIT_FAILURE;
 	}
 
-	/* Pass 1: tear down interfaces gone or changed, from the snapshot,
