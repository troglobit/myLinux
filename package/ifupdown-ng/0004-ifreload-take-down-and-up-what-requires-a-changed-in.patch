-		closedir(d);
+		load_applied(&old);
+		lif_state_sync(&state, &old);
+		find_stale(&stale, &old, &cur);
+		if (!takedown_stale(&stale, &old, &state, &gone))
+			rc = EXIT_FAILURE;
 	}
 
 	/* Pass 1 changed the state; reset refcounts and re-sync so a
@@ -347,7 +496,8 @@ ifreload_main(int argc, char *argv[])
 	}
 	lif_state_sync(&state, &cur);
 
-	/* Pass 2: bring up interfaces new or changed. */
+	/* Pass 2: bring up interfaces new or changed, and those that went
