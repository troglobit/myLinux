-	d = opendir(snapshot_dir());
-	if (d != NULL)
+	/* Pass 1: tear down interfaces gone or changed, and what requires
+	 * them, from the snapshot. */
+	if (any_stale(&cur))
 	{
-		struct dirent *ent;
-
-		while ((ent = readdir(d)) != NULL)
-		{
-			struct lif_dict_entry *ce;
-			char *stored;
-
-			if (ent->d_name[0] == '.')
-				continue;
-
-			ce = lif_dict_find(&cur, ent->d_name);
-			stored = read_file(snapshot_path(ent->d_name));
