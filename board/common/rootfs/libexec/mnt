#!/bin/sh

ident=$(basename "$0")
opt="-k"
rc=0

mp=/mnt/rw
dirs="/mnt/var.u /mnt/var.w /mnt/etc.u /mnt/etc.w $mp/vlib.u $mp/vlib.w\
      $mp/root.u $mp/root.w $mp/home.u $mp/home.w"
resetme="$mp/factory-reset.now"

mnt()
{
    fstab=""

    if [ -n "$FSTAB_FILE" ]; then
	    fstab="-T$FSTAB_FILE"
    fi

    mountpoint -q "$mp" && return 0

    # Only try the MTD backing when a Config partition exists, else the
    # failed lookup spams MTD errors on eMMC/disk (LABEL=Config) systems.
    if grep -q '"Config"' /proc/mtd 2>/dev/null; then
        mount "$fstab"   mtd:Config && return 0
    fi
    mount "$fstab" LABEL=Config && return 0

    return 1
}

# Finit bootstrap-style progress on the console, [ OK ]/[FAIL] and all.
status()
{
    GREEN="$(printf '\033[1;32m')"; RED="$(printf '\033[1;31m')"
    YELLOW="$(printf '\033[1;33m')"; BOLD="$(printf '\033[1m')"
    RESET="$(printf '\033[0m')"

    case $1 in
        0) color=$GREEN;  text=' OK ' ;;
        1) color=$RED;    text='FAIL' ;;
        2) color=$YELLOW; text='WARN' ;;
        *) color=$YELLOW; text=' .. ' ;;
    esac
    printf '%s[%s%s%s%s]%s ' "$BOLD" "$color" "$text" "$RESET" "$BOLD" "$RESET"
}
print_start() { printf '\r\033[K%s%s'   "$(status 3)" "$*" > /dev/console; }
print_end()   { r=$1; shift; printf '\r\033[K%s%s\n' "$(status "$r")" "$*" > /dev/console; }

# Hand the line back to Finit so its own [ OK ] for this step lands right.
print_restore() { print_start "Mounting filesystems from /etc/fstab.ro"; }

# A raised flag wipes the whole persistent store; /etc, /var, and the
# config datastore then regenerate from the read-only defaults on the way
# up (mech reseeds startup from the factory config).
factory_reset()
{
    print_start "Resetting to factory defaults ..."
    logger $opt -p user.notice -t "$ident" "Resetting to factory defaults."

    rm -rf "$mp"/* "$mp"/.[!.]* 2>/dev/null
    sync

    logger $opt -p user.notice -t "$ident" "Factory reset complete."
    print_end 0 "Factory reset complete."
    print_restore
}

# fall back to console logging if sysklogd is too old
if ! logger -? |grep -q "Log to kernel"; then
    opt="-c"
fi

if ! mnt; then
    logger $opt -p user.crit -t "$ident" \
	   "No persistent backing store available, falling back to tmpfs."
    mount "$fstab" tmpfs-Config
    rc=1
fi

chgrp wheel "$mp" && chmod g+w "$mp"

# Reset before recreating the overlay dirs, so the wipe leaves clean
# upper/work directories for the fstab overlays mounted right after us.
[ -f "$resetme" ] && factory_reset

for dir in $dirs; do
	mkdir -m 0755 "$dir" 2> /dev/null
done

exit $rc
